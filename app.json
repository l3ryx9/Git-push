{
  "expo": {
    "name": "Git-Push",
    "slug": "git-agend",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gitcrush",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050c0b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gitpush.app"
    },
    "android": {
      "package": "com.gitpush.app",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "./plugins/withLargeHeap.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
